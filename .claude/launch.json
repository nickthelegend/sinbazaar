{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sinbazaar-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true,
      "cwd": "app"
    },
    {
      "name": "sinbazaar-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3100"
      ],
      "port": 3100,
      "autoPort": false,
      "cwd": "app"
    }
  ]
}
