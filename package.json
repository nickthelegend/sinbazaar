{
  "name": "sinbazaar",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "anchor keys sync && anchor build && bash scripts/sync-idl.sh && node scripts/gen-counts.mjs",
    "sync:idl": "bash scripts/sync-idl.sh",
    "verify:idl": "bash scripts/sync-idl.sh --check",
    "stack": "bash scripts/local-stack.sh",
    "test": ". ./scripts/local-env.sh && ts-mocha -p ./tsconfig.json -t 1000000 --ignore tests/vrf-stall.ts tests/**/*.ts",
    "test:vrf-stall": "bash scripts/test-vrf-stall.sh",
    "seed": ". ./scripts/local-env.sh && ts-node scripts/seed.ts",
    "demo": ". ./scripts/local-env.sh && ts-node scripts/demo.ts",
    "keeper": ". ./scripts/local-env.sh && ts-node scripts/keeper.ts",
    "prove:action": ". ./scripts/local-env.sh && ts-node scripts/prove-magic-action.ts",
    "gen:counts": "node scripts/gen-counts.mjs",
    "verify:counts": "node scripts/gen-counts.mjs --check",
    "verify:market": ". ./scripts/local-env.sh && ts-node scripts/verify-market.ts",
    "verify:program": ". ./scripts/local-env.sh && ts-node scripts/verify-program.ts",
    "verify:all": "bash scripts/verify-all.sh"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@magicblock-labs/ephemeral-rollups-sdk": "0.17.0",
    "@solana/web3.js": "^1.98.0",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "chai": "^5.2.0",
    "mocha": "^11.2.2",
    "ts-mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}