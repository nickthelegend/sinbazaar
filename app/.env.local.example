# SINBAZAAR web app — localnet values.
# Mirrors scripts/local-env.sh. Copy to .env.local before `npm run dev`.
#
#   client -> QFS/TEE (6699) -> ER validator (7799) -> base solana validator (8899)

# Base Solana. Creation, delegation, tombstones, real SOL.
NEXT_PUBLIC_BASE_RPC=http://localhost:8899

# Ephemeral Rollup. Bidding, expiry, VRF, settlement.
NEXT_PUBLIC_ER_RPC=http://localhost:7799

# The authenticated read path. A JWT rides as ?token= on BOTH the http and the
# ws URL — never as a header. Locally this is the QFS shim; on devnet it is the
# real TEE endpoint (https://devnet-tee.magicblock.app).
NEXT_PUBLIC_TEE_RPC=http://localhost:6699

NEXT_PUBLIC_PROGRAM_ID=2WF8eFT97sGVYwGe5DNtLkGFW3kMJ6WXozGvT3eSzvEN

# Validator that must host both the market and its secret.
NEXT_PUBLIC_VALIDATOR=mAGicPQYBMvcYveUZA5F5UNNwyHvfYh5xkLS2Fr1mev

# VRF oracle queue, index 1, delegated to the ER.
NEXT_PUBLIC_VRF_QUEUE=Sc9MJUngNbQXSXGP3F67KvKwVnhaYn6kcioxXNVowYT

# localnet | devnet. Burner-wallet mode is the default on localnet, where a
# browser extension cannot reach the local validator.
NEXT_PUBLIC_CLUSTER=localnet

# ---- devnet ----------------------------------------------------------------
# NEXT_PUBLIC_BASE_RPC=https://api.devnet.solana.com
# NEXT_PUBLIC_ER_RPC=https://devnet-as.magicblock.app
# NEXT_PUBLIC_TEE_RPC=https://devnet-tee.magicblock.app
